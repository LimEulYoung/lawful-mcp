# Copy to .env and fill in. Every value is optional: with none of them set,
# the server runs against the bundled sample corpus with four of five tools.

# Corpus database. Defaults to the sample fixture in data/fixture.db.
# CORPUS_DB=/path/to/corpus.db

# Base URL for citation links in tool output. Defaults to the hosted service,
# whose case and statute ids match the published corpus.
# CASE_URL_BASE=https://lawful.crow-tit.com

# precedent_dive reads one judgment body and answers a question about it.
# Any OpenAI-compatible endpoint works. Without a key the tool is not
# registered and the other four still run.
# DIVE_API_KEY=
# DIVE_BASE_URL=https://api.openai.com/v1
# DIVE_MODEL=

# HTTP transport (--transport http). MCP_EXTRA_HOSTS lists public hostnames
# a reverse proxy forwards under; without them the DNS-rebinding guard
# rejects those requests.
# MCP_HOST=127.0.0.1
# MCP_PORT=8100
# MCP_EXTRA_HOSTS=mcp.example.com

# Dense retrieval (embeddings + rerank) instead of the lexical default.
# Needs the "dense" extra installed and a corpus built with vectors.
# USE_DENSE=1
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=
# EMBED_DIM=1024
# RERANK_BASE_URL=
# RERANK_API_KEY=
