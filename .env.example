# Configuration reference. The server does not load .env files automatically.
# Export selected values or pass them through your MCP client's env settings.
# With defaults, the bundled corpus runs with three tools and no API keys.

# Corpus database. Defaults to the sample fixture in data/fixture.db.
# CORPUS_DB=/path/to/corpus.db

# Base URL for citation links in tool output. Defaults to the hosted service,
# whose case and statute ids match the published corpus.
# CASE_URL_BASE=https://lawful.crow-tit.com

# precedent_dive sends a public judgment, its metadata and your question to
# an OpenAI-compatible model endpoint. DIVE_API_KEY, DIVE_BASE_URL and
# DIVE_MODEL are all required to register this fourth tool. Restart after changes.
# DIVE_API_KEY=
# DIVE_BASE_URL=https://api.openai.com/v1
# DIVE_MODEL=
# DIVE_TIMEOUT=15                      # optional, seconds

# HTTP transport (--transport http). The server has no built-in authentication.
# MCP_EXTRA_HOSTS is a comma-separated list of extra Host headers accepted
# by the DNS-rebinding guard, including :port when the header includes it.
# MCP_HOST=127.0.0.1
# MCP_PORT=8100
# MCP_EXTRA_HOSTS=mcp.example.com

# Dense retrieval (embeddings + rerank) instead of the lexical default.
# Needs the "dense" extra installed and a corpus built with vectors; the
# bundled sample has none. Sends queries to the embedding endpoint and,
# with USE_RERANK=1, queries and candidate excerpts to the reranking endpoint.
# USE_DENSE=1
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=
# EMBED_DIM=1024
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# USE_RERANK=1

# Advanced retrieval tuning. Leave these at their defaults for normal use.
# FTS_OR_MAX_TOKENS=40
# SNIPPET_TOKENS=256
# PREVIEW_TOP_K=3
# PREVIEW_MAX_CHARS=400
# RERANK_INPUT_MAX_CHARS=4000
